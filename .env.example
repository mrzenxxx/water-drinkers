# Скопировать в .env и заполнить. Настоящий .env в репозиторий не попадает.

# ─── База данных ─────────────────────────────────────────
# PostgreSQL с расширениями citext и btree_gist (их ставит начальная миграция).
DATABASE_URL="postgresql://waterdrinkers:waterdrinkers@localhost:5432/waterdrinkers?schema=public"

# ─── Приложение ──────────────────────────────────────────
# Внешний адрес: ссылки в письмах и cookie сессии.
APP_URL="http://localhost:3000"
# Секрет для подписи сессионных cookie (этап 2). Сгенерировать: openssl rand -base64 32
SESSION_SECRET=""

# ─── Распознавание чеков и помощник (этапы 6-7) ──────────
# Без ключа работает ManualReceiptExtractor — пустое извлечение с confidence: low (§8.1).
ANTHROPIC_API_KEY=""
# claude | manual
RECEIPT_EXTRACTOR="manual"

# ─── Почта для одноразовых кодов (этап 2) ────────────────
# Провайдер ещё не выбран (открытый вопрос №4). console печатает код в лог;
# smtp намеренно падает, чтобы молчаливая заглушка не выглядела рабочей.
# smtp | console (console печатает код в лог, для локальной разработки)
MAIL_PROVIDER="console"
MAIL_FROM="WaterDrinkers <no-reply@sspk.spb.ru>"
SMTP_URL="smtp://user:password@localhost:1025"
# Домен рабочей почты для белого списка (§7). Домена мало: адрес должен ещё
# числиться среди участников — обе проверки в src/lib/auth/whitelist.ts.
ALLOWED_EMAIL_DOMAIN="sspk.spb.ru"

# ─── Хранилище чеков (этап 6) ────────────────────────────
# Открытый вопрос №6: файловая система или S3-совместимое хранилище.
UPLOAD_DIR="./uploads"
