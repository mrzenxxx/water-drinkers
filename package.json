    "db:seed:mock": "tsx prisma/seed-mock.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dataloader": "2.2.3",
    "graphql": "16.14.2",
    "graphql-yoga": "5.21.3",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
