// WaterDrinkers — схема базы данных.
// Точное отражение SQL-схемы из docs/SPEC.md §11.
//
// Соглашения:
//  * Деньги — BigInt (копейки). Плавающая точка в денежных полях запрещена (CLAUDE.md, правило 2).
//  * Перечисления (role, status, type) хранятся как TEXT — ровно как в §11,
//    без создания PostgreSQL-типов. Допустимые значения перечислены в комментариях.
//  * Ссылочные действия заданы явно как NoAction: это поведение SQL-схемы (§11 не задаёт
//    ON DELETE / ON UPDATE, значит действует NO ACTION). Умолчания Prisma другие
//    (Restrict / SetNull), поэтому их приходится переопределять.
//  * CHECK-ограничения и EXCLUDE USING gist Prisma не выражает — они живут
//    в ручной миграции prisma/migrations/0_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  /// Необязательна: входят по логину, почта — только для справки (ADR-0004).
  email          String?   @unique @db.Citext
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  middleName     String?   @map("middle_name")
  /// Выдаётся администратором, по умолчанию из ФИО: `e.v.kondobarov`.
  login          String    @unique @db.Citext
  /// Отпечаток scrypt. `null` — учётные данные ещё не выданы, войти нельзя.
  passwordHash   String?   @map("password_hash")
  /// HMAC токена магической ссылки. Ссылка одна на участника, многоразовая
  /// до срока; перевыпуск учётных данных её заменяет.
  magicLinkHash      String?   @unique @map("magic_link_hash")
  magicLinkExpiresAt DateTime? @map("magic_link_expires_at") @db.Timestamptz(6)
  departmentId   String?   @map("department_id") @db.Uuid
  /// NONE | MUTED | BANNED. MUTED — только просмотр, BANNED — вход закрыт.
  restriction    String    @default("NONE")
  /// Сессии, выданные раньше этого момента, недействительны: так отзываются
  /// все входы участника при бане и перевыпуске учётных данных.
  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz(6)
  /// Защита от перебора пароля: неудачи подряд и блокировка до момента.
  failedLogins   Int       @default(0) @map("failed_logins") @db.SmallInt
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  /// PARTICIPANT | ADMIN
  role           String    @default("PARTICIPANT")
  joinedAt       DateTime  @map("joined_at") @db.Date
  leftAt         DateTime? @map("left_at") @db.Date
  openingBalance BigInt    @default(0) @map("opening_balance")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Момент последнего захода в раздел «Объявления» (§6.12). Из него выводится
  /// число непрочитанного: отдельная таблица «кто что прочитал» для полутора
  /// десятков человек и десятка объявлений была бы дороже пользы.
  announcementsSeenAt DateTime? @map("announcements_seen_at") @db.Timestamptz(6)

  identities             Identity[]
  contributions          Contribution[]    @relation("ContributionAuthor")
  reviewedContributions  Contribution[]    @relation("ContributionReviewer")
  createdWaterOrders     WaterOrder[]      @relation("WaterOrderCreator")
  absences               Absence[]
  fundTransactions       FundTransaction[] @relation("FundTransactionUser")
  createdFundTransactions FundTransaction[] @relation("FundTransactionCreator")
  auditEntries           AuditEntry[]
  assistantMessages      AssistantMessage[]
  announcements          Announcement[]
  department             Department?        @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("users")
}

/// Справочник отделов. Пополняется администратором прямо из формы участника.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users User[]

  @@map("departments")
}

model Identity {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  /// email | telegram
  provider   String
  providerId String @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, providerId])
  @@map("identities")
}

/// Одна строка на всю систему: CHECK (id = 1) стоит в ручной миграции.
model FundSettings {
  id                  Int       @id @default(1) @db.SmallInt
  openingBalance      BigInt    @default(0) @map("opening_balance")
  startDate           DateTime? @map("start_date") @db.Date
  /// 50000 копеек = 500 ₽
  defaultContribution BigInt    @default(50000) @map("default_contribution")

  @@map("fund_settings")
}

model Receipt {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @map("storage_key")
  mediaType  String   @map("media_type")
  /// Размер файла в байтах: подпись кнопки не должна вычитывать сам файл.
  byteSize   Int      @default(0) @map("byte_size")
  extraction Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file          ReceiptFile?
  contributions Contribution[]
  waterOrders   WaterOrder[]

  @@map("receipts")
}

/// Байты чека отдельной таблицей: Prisma выбирает все колонки, и BYTEA внутри
/// receipts означал бы, что каждый список взносов и заказов вычитывает
/// мегабайты, которые ему не нужны (ADR-0003).
model ReceiptFile {
  receiptId String   @id @map("receipt_id") @db.Uuid
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("receipt_files")
}

model Contribution {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// копейки, CHECK (amount > 0) в ручной миграции
  amount BigInt
  paidAt DateTime @map("paid_at") @db.Date
  /// PENDING | CONFIRMED | RECORDED | REJECTED
  status        String    @default("PENDING")
  receiptId     String?   @map("receipt_id") @db.Uuid
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewComment String?   @map("review_comment")
  historical    Boolean   @default(false)
  /// Внесено администратором за участника (§6.7). Не путать с `historical`:
  /// тот про перенесённую историю, этот — про то, чьими руками создана запись.
  enteredByAdmin Boolean  @default(false) @map("entered_by_admin")

  user     User     @relation("ContributionAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer User?    @relation("ContributionReviewer", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("contributions")
}

model WaterOrder {
  id String @id @default(uuid()) @db.Uuid
  /// копейки, CHECK (amount > 0) в ручной миграции
  amount       BigInt
  orderedAt    DateTime @map("ordered_at") @db.Date
  bottlesCount Int?     @map("bottles_count")
  supplier     String?
  note         String?
  receiptId    String?  @map("receipt_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  historical   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User     @relation("WaterOrderCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("water_orders")
}

/// CHECK (ends_on >= starts_on) и запрет пересечений (EXCLUDE USING gist)
/// заданы в ручной миграции: Prisma такие ограничения не описывает.
model Absence {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// VACATION | SICK_LEAVE
  type     String
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date
  note     String?
  /// Внесено администратором за участника (§6.7).
  enteredByAdmin Boolean @default(false) @map("entered_by_admin")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("absences")
}

/// Журнал операций фонда. Неизменяем: только вставка (CLAUDE.md, правило 4).
model FundTransaction {
  id String @id @default(uuid()) @db.Uuid
  /// OPENING | CONTRIBUTION | ORDER | SETTLEMENT | ADJUSTMENT
  type String
  /// копейки, со знаком
  amount    BigInt
  userId    String?  @map("user_id") @db.Uuid
  /// ссылка на contribution / water_order
  refId     String?  @map("ref_id") @db.Uuid
  comment   String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User? @relation("FundTransactionUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User? @relation("FundTransactionCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("fund_transactions")
}

/// Объявления администратора (§6.12): инструкции и сообщения всем участникам.
///
/// Денег не касается вовсе: ни строки в `fund_transactions`, ни участия
/// в расчёте. Правило 4 CLAUDE.md о неизменяемости журнала сюда не
/// распространяется — опечатку в инструкции нужно уметь исправить, — но
/// каждая правка ложится в `audit_log` с before/after.
model Announcement {
  id String @id @default(uuid()) @db.Uuid
  title String
  body  String
  /// Закреплённое не тонет в ленте: так живут инструкции по пользованию.
  pinned Boolean @default(false)
  /// `null` — черновик, виден только администратору.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// Убрано с глаз, но не удалено: история сообщений остаётся.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Приложенная картинка. Здесь только её описание — сами байты лежат
  /// в отдельной таблице, иначе каждая выборка списка тащила бы их в память.
  /// `null` во всех четырёх полях означает «картинки нет».
  imageMediaType String? @map("image_media_type")
  /// Описание для тех, кто картинку не видит. При картинке обязательно (§12).
  imageAlt       String? @map("image_alt")
  imageWidth     Int?    @map("image_width")
  imageHeight    Int?    @map("image_height")

  author User               @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  image  AnnouncementImage?

  @@index([publishedAt])
  @@map("announcements")
}

/// Байты картинки объявления — отдельной таблицей, а не колонкой в `announcements`.
///
/// Prisma выбирает все колонки, если не попросить иначе, и `BYTEA` в самой
/// таблице означал бы, что список объявлений на каждом экране вычитывает из
/// базы мегабайты, которые ему не нужны. Здесь их читает ровно один обработчик
/// — `/api/notices/[id]/image`.
model AnnouncementImage {
  announcementId String   @id @map("announcement_id") @db.Uuid
  bytes          Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("announcement_images")
}

model AuditEntry {
  id       BigInt  @id @default(autoincrement())
  actorId  String? @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String? @map("entity_id") @db.Uuid
  before   Json?
  after    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorId, action, createdAt])
  @@map("audit_log")
}

model AssistantMessage {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// user | assistant
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("assistant_messages")
}
