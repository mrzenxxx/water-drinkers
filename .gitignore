# Зависимости
node_modules/
.pnp
.pnp.js

# Сборка
.next/
out/
build/
dist/
*.tsbuildinfo

# Клиент Prisma — генерируется из схемы (npm run db:generate)
/src/generated/

# Окружение — секреты в репозиторий не попадают
# Любые копии окружения тоже: `.env.bak`, `.env.production` и т. п.
.env
.env.*
!.env.example

# Тесты и покрытие
coverage/
.nyc_output/

# Логи
*.log
npm-debug.log*
yarn-error.log*

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Загруженные чеки при локальной разработке
/uploads/
/storage/

# Личные настройки Claude Code (общие лежат в .claude/settings.json)
.claude/settings.local.json

# Рабочие копии субагентов
.claude/worktrees/

# Рабочие каталоги выполнения планов (ледджер, брифы, отчёты)
/.superpowers/

# Дампы базы для переноса на сервер (deploy/README.md): живые данные, не код
/dumps/
