# Всё, что собирается внутри образа заново или не нужно ему вовсе.
node_modules
.next
src/generated
coverage

# Секреты в образ не попадают: окружение приходит из compose на сервере.
.env
.env.*
!.env.example
deploy/.env
# Дампы базы с живыми данными в контекст сборки не попадают.
dumps

.git
.claude
.superpowers
# docs не нужны, кроме руководства: его читает с диска страница /guide.
docs
!docs/USER_GUIDE.md
tests
*.log
.DS_Store
